{
    "name": "bf6mods",
    "private": true,
    "version": "1.0.0",
    "description": "Monorepo for BF6 modding tools and type definitions",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "npm run build:sdk && npm run build:portal && npm run build:cli",
        "build:sdk": "npm --workspace=@bf6mods/sdk run build",
        "build:portal": "npm --workspace=@bf6mods/portal run build",
        "build:cli": "npm --workspace=@bf6mods/cli run build",
        "test": "vitest",
        "lint": "biome check",
        "lint:fix": "biome check --write",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "generate:mutators": "node --experimental-strip-types ./scripts/generateMutators.ts"
    },
    "devDependencies": {
        "@biomejs/biome": "2.2.5",
        "@types/node": "^24.7.1",
        "tsdown": "^0.15.9",
        "typescript": "^5.9.3",
        "vitepress": "^2.0.0-alpha.15",
        "vitest": "^4.0.2"
    }
}
