{
	"name": "@bf6mods/cli",
	"version": "1.8.0",
	"description": "CLI and library for bundling BF6 mods",
	"license": "MIT",
	"type": "module",
	"bin": {
		"bf6mods": "./dist/cli/index.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsdown",
		"start": "cross-env EXIT_CODE=none tsx ./src/cli/index.ts"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist/"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bf6mods/bf6mods.git"
	},
	"dependencies": {
		"@bf6mods/portal": "*",
		"@bf6mods/sdk": "*",
		"@clack/prompts": "^1.8.1",
		"chokidar": "^5.0.0",
		"colors": "^1.4.0",
		"commander": "^15.0.0",
		"import-global": "^1.1.1",
		"jiti": "^2.7.0",
		"keytar": "^7.9.0",
		"knitwork": "^1.3.0",
		"rolldown": "^1.2.9",
		"sharp": "^0.35.4",
		"stringify-object": "^7.0.0",
		"strip-ansi": "^7.2.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@oxc-project/types": "^0.150.0",
		"@types/stringify-object": "^4.0.5",
		"cross-env": "^10.1.0",
		"execa": "^10.0.1",
		"puppeteer": "^25.11.0",
		"tsx": "^4.23.13"
	}
}
